# Сборка
build/
out/
cmake-build-*/
CMakeUserPresets.json

# Реальная выгрузка матчей: данные не место в репозитории.
# Схема лежит в project/data/sample_match.json, тесты работают на фикстурах.
project/data/matches/
project/data/timelines/

# То же самое, но не туда: скрипт запускали из папки scripts/, и он создал
# своё дерево project/data рядом с собой. Эти матчи стоит перенести
# в project/data/matches/ и запускать fetch_matches.py из корня репозитория.
scripts/project/

# Ключ Riot живёт только в переменной окружения. Здесь его быть не должно.
.env
*.key

# Артефакты ручной сборки экспериментов темы 0
*.obj
*.exe
*.pdb
*.ilk
*.o
*.a
*.out
theory/**/experiments/**/a.out
theory/**/experiments/**/main

# Страница теории собирается из theory/*/THEORY.md скриптом scripts/build_theory.py
# на каждой сборке. Исходник — Markdown, он и лежит в репозитории.
theory/index.html

# IDE
.vs/
.idea/
.vscode/
*.user

# Фронтенд: зависимости и сборка. Источник правды — web/src.
web/node_modules/
web/dist/

# vcpkg ставит зависимости по манифесту в каталог сборки.
vcpkg_installed/
build-noadmin/

# Учебные материалы курса: к продукту отношения не имеют, история и
# состояние обучения остаются локально.
PROGRESS.md
REVIEW.md
CLAUDE.md
.claude/
