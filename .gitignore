# Сборка
build/
out/
cmake-build-*/
CMakeUserPresets.json

# Реальная выгрузка матчей: данные не место в репозитории.
# Схема лежит в project/data/sample_match.json, тесты работают на фикстурах.
project/data/matches/
project/data/timelines/

# То же самое, но не туда: скрипт запускали из папки scripts/, и он создал
# своё дерево project/data рядом с собой. Эти матчи стоит перенести
# в project/data/matches/ и запускать fetch_matches.py из корня репозитория.
scripts/project/

# Ключ Riot живёт только в переменной окружения. Здесь его быть не должно.
.env
*.key

# Артефакты ручной сборки вне CMake
*.obj
*.exe
*.pdb
*.ilk
*.o
*.a
*.out

# IDE
.vs/
.idea/
.vscode/
*.user

# Python: кеш байткода скриптов.
__pycache__/

# vcpkg ставит зависимости по манифесту в каталог сборки.
vcpkg_installed/
build-noadmin/

# База матчей и статика Data Dragon: гигабайты, пересобираются краулером.
# Источник правды для приложения — пак в project/data/packs, он маленький
# и в репозиторий попадает.
project/data/base.sqlite
project/data/base.sqlite-*
# История матчей игроков (окно профиля). До сервера — локальный файл
# разработчика; схема в project/data/history_schema.sql в репозитории.
project/data/history.sqlite
project/data/history.sqlite-*
project/data/static/
